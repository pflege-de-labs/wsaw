[Unit]
Description=Caddy front proxy for wsaw
Documentation=https://caddyserver.com/docs/
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=caddy
Group=caddy

Environment=XDG_DATA_HOME=/var/lib/caddy
Environment=XDG_CONFIG_HOME=/etc/caddy

ExecStart=/usr/local/bin/caddy run --config /etc/caddy/Caddyfile
ExecReload=/usr/local/bin/caddy reload --config /etc/caddy/Caddyfile --force

Restart=on-failure
RestartSec=5s

# Binds 80/443 without running as root: the capability is granted, root
# privileges are not (NoNewPrivileges rules out gaining any more).
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/caddy
LimitNOFILE=1048576
MemoryMax=128M

[Install]
WantedBy=multi-user.target
